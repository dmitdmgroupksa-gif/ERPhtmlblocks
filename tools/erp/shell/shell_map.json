{
  "_about": "Selectors are relative to root. header = navy title band; tabs = royal tab bar; bar = royal strip holding tabs + buttons when there is no title header; filters = white filter card; order = parent whose children are reordered header -> tabs -> filters ('&' = root itself). Excluded on purpose: CEO Agent, Durar Messenger, Durar Sheets (apps with their own chrome), the six Blocked Customer cards (compact cards without a header), CEO Command Center, Credit Controller Dashboard, FM & Inventory Dashboard, Treasury Dashboard, Accounts Payable, Finance Manager Dashboard, Finance Internal Controller, VAT & ZATCA Compliance, SOA Manager, SOA Request Dashboard, Collector, Payroll Cost Center, DMS Sales Management, Lead Management, My Leads, Pre-Procurement, DN & GRN Tracker, Customs & Post-Processing, Inventory Dashboard, Logistics Dashboard, Operation Dashboard, Delivery & Forklift, Scaffolding Rental, Manufacturing Dashboard, Production Dashboard, Plant & Furniture Asset Dashboard, Admin HR Dashboard, Admin & HR Platform, Employee Vacation, Government Relations Dashboard, Technical Department, DMS Technical Department, My DMS Projects, DM Contracting Dashboard and Quotation & SO Tracker (built on the standard directly).",
  "08. Operations & Logistics/Fleet Dashboard": {
    "root": "#dm-fleet",
    "header": ".df-header",
    "hbtn": ".df-btn",
    "hprimary": ".df-btn.primary",
    "tabs": ".df-tabs",
    "tab": "button",
    "active": [
      "button.active",
      "button[aria-selected='true']"
    ],
    "filters": ".df-filters",
    "grid": false,
    "fbtn": [
      ".df-btn"
    ],
    "dark": "#dm-fleet.df-dark",
    "extra": [
      ".df-tabs { display: flex; grid-auto-flow: unset; }"
    ]
  },
  "05. HR & Administration/Employee Dashboard": {
    "root": "#ess",
    "header": ".top",
    "tabs": ".top nav",
    "tab": "a",
    "active": [
      "a.on"
    ],
    "tabs_in_header": true,
    "lang": [
      ".edp-lang"
    ],
    "langon": ".on"
  },
  "07. IT & Digital Systems/Digital Marketing Dashboard": {
    "root": ".dmo",
    "bar": ".dmo-top",
    "barbtn": [
      ".dmo-refresh",
      ".dmo-lang"
    ],
    "barlabel": [
      ".dmo-auto"
    ],
    "tabs": ".dmo-tabs",
    "tab": ".dmo-tab",
    "active": [
      ".dmo-tab.active"
    ],
    "tabs_in_header": true,
    "filters": ".dmo-filters",
    "grid": false,
    "fbtn": [
      "button"
    ]
  },
  "07. IT & Digital Systems/ERP User Access": {
    "root": ".uad",
