    "active": [
      "button.active"
    ],
    "tabs_in_header": true,
    "hextra": [
      "{ display: grid; grid-template-columns: 1fr auto; }",
      "#dmr-nav { grid-column: 1 / -1; }",
      ".dmr-heading { grid-column: 1 / -1; }"
    ]
  },
