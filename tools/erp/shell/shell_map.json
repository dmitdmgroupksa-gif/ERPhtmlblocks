    "langon": ".on",
    "tabs": ".uad-tabs",
    "tab": "button",
    "active": [
      "button.active",
      "button[aria-selected='true']"
    ],
    "hextra": [
      ".uad-sel { color: rgb(255 255 255 / 85%); }",
      ".uad-sel select { height: 34px; border-radius: 8px; border: 1px solid rgb(255 255 255 / 30%); background: rgb(255 255 255 / 10%); color: #fff; }",
      ".uad-sel select option { color: #16202e; }"
    ]
  },
  "07. IT & Digital Systems/IT Asset Acquisition": {
    "root": "#dm-aar-dashboard",
