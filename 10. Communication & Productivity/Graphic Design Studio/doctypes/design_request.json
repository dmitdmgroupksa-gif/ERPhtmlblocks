{
 "doctype": "DocType",
 "name": "Design Request",
 "module": "Custom",
 "custom": 1,
 "istable": 0,
 "issingle": 0,
 "track_changes": 1,
 "autoname": "DR-.#####",
 "naming_rule": "Expression (old style)",
 "title_field": "title",
 "show_title_field_in_link": 1,
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1
  },
  {
   "role": "Design Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1
  },
  {
   "role": "Employee",
   "read": 1,
   "write": 1,
   "create": 1,
   "if_owner": 1
  }
 ],
 "fields": [
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "request_type",
   "fieldtype": "Select",
   "label": "Type",
   "options": "Flyer\nBanner\nSocial post\nSignage\nPresentation\nPrinted business cards\nOther",
   "in_list_view": 1
  },
  {
   "fieldname": "brand",
   "fieldtype": "Link",
   "label": "Brand",
   "options": "Design Brand"
  },
  {
   "fieldname": "needed_by",
   "fieldtype": "Date",
   "label": "Needed by",
   "in_list_view": 1
  },
  {
   "fieldname": "priority",
   "fieldtype": "Select",
   "label": "Priority",
   "options": "Low\nNormal\nHigh\nUrgent",
   "default": "Normal"
  },
  {
   "fieldname": "brief",
   "fieldtype": "Text",
   "label": "Brief"
  },
  {
   "fieldname": "files",
   "fieldtype": "Table",
   "label": "Files",
   "options": "Design Request File"
  },
  {
   "fieldname": "requested_by",
   "fieldtype": "Link",
   "label": "Requested by",
   "options": "User"
  },
  {
   "fieldname": "employee",
   "fieldtype": "Link",
   "label": "Employee",
   "options": "Employee"
  },
  {
   "fieldname": "employee_name",
   "fieldtype": "Data",
   "label": "Employee name"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Submitted\nIn progress\nNeeds info\nDelivered\nClosed\nCancelled",
   "default": "Submitted",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "designer_note",
   "fieldtype": "Small Text",
   "label": "Designer note"
  },
  {
   "fieldname": "change_note",
   "fieldtype": "Small Text",
   "label": "Change request"
  },
  {
   "fieldname": "delivered_on",
   "fieldtype": "Datetime",
   "label": "Delivered on"
  },
  {
   "fieldname": "notified",
   "fieldtype": "Check",
   "label": "Requester emailed"
  },
  {
   "fieldname": "notify_error",
   "fieldtype": "Small Text",
   "label": "Email problem"
  }
 ]
}
