{
 "doctype": "DocType",
 "name": "Design Asset",
 "module": "Custom",
 "custom": 1,
 "istable": 0,
 "issingle": 0,
 "track_changes": 1,
 "autoname": "hash",
 "naming_rule": "Random",
 "title_field": "title",
 "show_title_field_in_link": 1,
 "search_fields": "asset_type,tags",
 "image_field": "thumbnail",
 "fields": [
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "asset_type",
   "fieldtype": "Select",
   "label": "Asset type",
   "options": "Logo\nBackground\nPrint\nSocial post\nSignage\nVehicle branding\nPresentation\nPhoto\nPackaging\nFont\nOther",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "brands",
   "fieldtype": "Table MultiSelect",
   "label": "Brands",
   "options": "Design Asset Brand"
  },
  {
   "fieldname": "tags",
   "fieldtype": "Data",
   "label": "Tags"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nPublished\nArchived",
   "default": "Draft",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "version",
   "fieldtype": "Int",
   "label": "Version",
   "default": "1"
  },
  {
   "fieldname": "previous_version",
   "fieldtype": "Link",
   "label": "Previous version",
   "options": "Design Asset"
  },
  {
   "fieldname": "file",
   "fieldtype": "Attach",
   "label": "File"
  },
  {
   "fieldname": "source_link",
   "fieldtype": "Data",
   "label": "Source file link"
  },
  {
   "fieldname": "preview",
   "fieldtype": "Attach Image",
   "label": "Preview"
  },
  {
   "fieldname": "thumbnail",
   "fieldtype": "Attach Image",
   "label": "Thumbnail"
  },
  {
   "fieldname": "formats",
   "fieldtype": "Data",
   "label": "Formats"
  },
  {
   "fieldname": "licence_expiry",
   "fieldtype": "Date",
   "label": "Licence expiry"
  },
  {
   "fieldname": "download_count",
   "fieldtype": "Int",
   "label": "Downloads",
   "read_only": 1
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Description"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1
  },
  {
   "role": "Design Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1
  }
 ]
}
